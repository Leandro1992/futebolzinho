# Optional: leave empty to use local Next API routes (/api/*)
NEXT_PUBLIC_API_BASE_URL=

# Cloudflare R2 da quadra de quinta. O secret fica só no servidor.
R2_ENDPOINT=https://fd60543138bd6390657d8847d13e785d.r2.cloudflarestorage.com
R2_BUCKET=videos-futebolzinho-quinta
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=

# Firebase Admin service account (used when credenciais.json is not present)
type=service_account
project_id=
private_key_id=
private_key="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email=
client_id=
auth_uri=https://accounts.google.com/o/oauth2/auth
token_uri=https://oauth2.googleapis.com/token
auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
client_x509_cert_url=
universe_domain=googleapis.com
